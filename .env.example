# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Database (checkpoints, runs, events) ---
DATABASE_URL=postgresql+psycopg://agentflow:agentflow@localhost:5432/agentflow
# For zero-infra local dev, swap to SQLite instead:
# DATABASE_URL=sqlite:///./agentflow.db

# --- Redis (short-term memory) ---
REDIS_URL=redis://localhost:6379/0

# --- Chroma (episodic + long-term memory, embedded mode) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- LLM provider ---
ANTHROPIC_API_KEY=

# --- Sandbox ---
SANDBOX_MODE=docker   # docker | subprocess
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEM_LIMIT=256m
SANDBOX_TIMEOUT_SECONDS=30

# --- Escalation thresholds (0-1 risk score) ---
ESCALATION_CONTINUE_MAX=0.35
ESCALATION_APPROVE_MAX=0.7
